# ============================================
# Chief of Staff — .gitignore
# ============================================
# This template ships with example data that IS committed so new users
# can see the structure. After you customize with your real data,
# uncomment the relevant lines below to protect your personal information.

# ------ YOUR PERSONAL DATA ------
# These are ignored by default to protect personal data.
# Example data lives in examples/ for reference.

data/contacts.json
data/decisions.json
data/meetings.json
data/intelligence.json
data/tasks.json
data/connections.json
data/standup-latest.md
data/briefing-latest.md

# Intelligence research files (created by background agents)
data/intelligence/

# ------ SENSITIVE DOMAIN FILES ------
# Uncomment domains that contain personal/sensitive content:
# domains/04-stakeholders.md
# domains/08-family.md
# domains/10-finance.md

# ------ PIPELINE FILES ------
# These are local pipeline configuration — never push to public repo.
release.json
release-history.json
sanitization-reports/
comparison-reports/

# ------ ALWAYS IGNORED ------

# Environment files (API keys)
scripts/.env
*.env

# OS files
.DS_Store
Thumbs.db

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
