# Email notifications (optional)
# Uses Resend API — sign up at https://resend.com
RESEND_API_KEY=re_your_api_key_here
NOTIFY_TO=your@email.com
# Optional: custom sender (requires verified domain in Resend)
# Without this, sends from onboarding@resend.dev
FROM_ADDRESS=Chief of Staff <chief-of-staff@yourdomain.com>
